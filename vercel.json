{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/HOME-MESSEDAGE",
      "destination": "/home-massage",
      "permanent": true
    },
    {
      "source": "/home-messedage",
      "destination": "/home-massage",
      "permanent": true
    },
    {
      "source": "/Home-Messedage",
      "destination": "/home-massage",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
